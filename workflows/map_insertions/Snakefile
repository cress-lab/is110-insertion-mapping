"""
Workflow for mapping insertions against the genome. Developed with snakemake 9.3

wk_dir: 
fastq_path: 
others: 
brna_plasmid: 
insert_end_length: 
insertion_end_to_extract: 
min_trimmed_read_length: 
quality_filter: 
fasta_16s: 

"""
import os
from Bio import SeqIO
import glob
import sys
import gzip

WK_DIR = config["wk_dir"]
BRNA_PLASMID_PATH = config["brna_plasmid"]
OTHER_SEQUENCE_PATHS = config["others"]
FASTQ_PATH = config["fastq_path"]
INSERTION_END_TO_EXTRACT = config.get("insertion_end_to_extract", "R") # Default to extracting RE
INSERT_END_LENGTH = config.get("insert_end_length", 200) # How much of the insertion end to extract
COMPUTE_COVERAGE = config.get('compute_coverage', False)
QUALITY_FILTER = config.get("quality_filter", 0) # Default to no quality filtering
MIN_TRIMMED_READ_LENGTH = config.get("min_trimmed_read_length", 1) # Default minimum trimmed read length
FASTA_16S = config.get("fasta_16s", False) # Whether to explicitly map reads to 16S vs genomes

SCRIPT_DIR = "../../scripts"
MAP_ENV = "../../envs/map_env.yml"


def cutadapt_end_option(end):
    if end == "R":
        return "g"
    elif end == "L":
        return "a"
    else:
        raise ValueError(f"Invalid end: {end}")


rule all:
    input:
        f"{WK_DIR}/plots/.plots_complete",
        os.path.join(WK_DIR, "read_counts.txt"),
        # f"{WK_DIR}/.blastn_complete", # NOTE: TEMPORARY BLASTN SANITY CHECK


rule extract_insertion_end:
    """
    Scans provided sequence files for bRNA and extracts either the upstream (LE)
    or downstream (RE) end of the resulting insertion sequence. 
    """
    input:
        brna=BRNA_PLASMID_PATH,
        others=OTHER_SEQUENCE_PATHS,
        extract_insertion_end_script=f"{SCRIPT_DIR}/extract_insertion_end.py"
    output:
        end_file=f"{WK_DIR}/input/{INSERTION_END_TO_EXTRACT}E.fasta",
        target_sites_file=f"{WK_DIR}/input/target_sites.tsv"
    conda:
        MAP_ENV
    shell:
        """
        mkdir -p {WK_DIR}/input
        python {input.extract_insertion_end_script} \
            -b {input.brna} \
            -s {input.others} \
            -o {WK_DIR}/input \
            -n {INSERT_END_LENGTH} \
            -m {INSERTION_END_TO_EXTRACT} \
            --save_targets
        """


rule genbank_to_fasta:
    """
    Creates a fasta file of all contigs contained in the provided sequence files
    (specifically, this includes all files referenced in the config as 
    "brna_plasmid" or "others")
    """
    input:
        rules.extract_insertion_end.output.end_file,
        brna=BRNA_PLASMID_PATH,
        others=OTHER_SEQUENCE_PATHS
    output:
        fasta=f"{WK_DIR}/input/sequences.fasta"
    conda:
        MAP_ENV
    shell:
        """
        python {SCRIPT_DIR}/genbank_to_fasta.py {output.fasta} {input.brna} {input.others}
        """

rule filter_read_quality:
    """
    Filter out reads with average read quality below QUALITY_FILTER, and trim
    low-quality base calls from the end of all reads. Defaults to using a 
    quality filter of 0. 
    """
    input:
        fastq=FASTQ_PATH
    output:
        reads_quality_filtered=f"{WK_DIR}/reads_quality_filtered.fastq",
    conda:
        MAP_ENV
    shell:
        """
        cutadapt -q {QUALITY_FILTER},{QUALITY_FILTER} {input.fastq} | seqkit seq -Q {QUALITY_FILTER} -o {output.reads_quality_filtered}
        """

rule cutadapt_extract_insertions:
    """
    Use cutadapt to search for reads containing the insertion end, and trim off
    the segments of those reads with the insertion sequence to enable mapping
    later. 
    """
    input:
        rules.genbank_to_fasta.output.fasta,
        end_file = rules.extract_insertion_end.output.end_file,
        fastq = rules.filter_read_quality.output.reads_quality_filtered
    output:
        reads_with_insertion = f"{WK_DIR}/{INSERTION_END_TO_EXTRACT}E_contain_reads_any.fasta",
        reads_no_insertion = f"{WK_DIR}/reads_no_insertion.fasta", # TODO: delete me?
        reads_too_short = f"{WK_DIR}/{INSERTION_END_TO_EXTRACT}E_contain_reads_below_{MIN_TRIMMED_READ_LENGTH}nt.fasta"
    conda:
        MAP_ENV
    params:
        end_option = lambda wildcards: cutadapt_end_option(INSERTION_END_TO_EXTRACT)
    shell:
        """
        cutadapt \
            -{params.end_option} "file:{input.end_file}" \
            --revcomp --fasta \
            --untrimmed-output {output.reads_no_insertion} \
            --too-short-output {output.reads_too_short} \
            -O 20 \
            -j 0 \
            -m {MIN_TRIMMED_READ_LENGTH} \
            {input.fastq} > {output.reads_with_insertion}
        """

rule cutadapt_trim_2:
    """
    Use cutadapt to remove trimmed reads that contain multiple insertion ends. 
    """
    input:
        trimmed = rules.cutadapt_extract_insertions.output.reads_with_insertion,
        end_file = rules.extract_insertion_end.output.end_file
    output:
        trimmed_1_insert=f"{WK_DIR}/{INSERTION_END_TO_EXTRACT}E_contain_reads.fasta",
    conda:
        MAP_ENV
    params:
        end_option = lambda wildcards: cutadapt_end_option(INSERTION_END_TO_EXTRACT)
    shell:
        """
        cutadapt \
            --revcomp \
            --fasta \
            --discard-trimmed \
            -O 20 \
            -j 0 \
            -{params.end_option} file:{input.end_file} \
            {input.trimmed} > {output.trimmed_1_insert}
        """


rule map_insertions:
    """
    Workhorse rule that maps all reads determined to contain the desired 
    insertion sequence against provided files. By default, this accomplishes 
    this by mapping insertion end-containing reads against the output of the
    genbank_to_fasta rule (a.k.a. all sequences provided under the 
    "brna_plasmid" or "other" in the config). If you've provided a fasta_16s
    file in the config, this will first map reads against that file, and then 
    separately map unmapped and mapped reads against the genbank_to_fasta 
    output.
    """
    input:
        sequences_map_to=rules.genbank_to_fasta.output.fasta,
        reads=rules.cutadapt_trim_2.output.trimmed_1_insert,
        # Scripts used for 16S option
        map_16s_script=f"{SCRIPT_DIR}/map_16S.sh",
        map_16s_helper_script=f"{SCRIPT_DIR}/process_16s_blastn.py",
    output:
        mapping_complete=f"{WK_DIR}/.mapping_complete"
    conda:
        MAP_ENV
    threads: 48
    run:
        # If 16S file provided, perform map reads to 16S first and map non-16S reads to genomes/plasmids
        if FASTA_16S:
            print("Mapping to 16S sequences as well as genomes")
            shell(f"""
                {input.map_16s_script} {input.reads} {FASTA_16S} {input.sequences_map_to}
                """)
        # If no 16S file provided, just map all the reads onto the collection of genomes
        else:
            print("Mapping reads to genomes/plasmids only")
            shell(f"""
                minimap2 -t {threads} -ax map-ont {input.sequences_map_to} {input.reads} |
                samtools view -bS |
                samtools sort -o {WK_DIR}/aligned_contigs.bam -
                samtools index {WK_DIR}/aligned_contigs.bam
            """)
        shell(f"""
            touch {output.mapping_complete}
        """)


rule optional_compute_coverage:
    """
    Computes coverage across all provided genomes/plasmids by manually mapping 
    all reads against them. Only runs if compute_coverage is True in the config.
    """
    input:
        genome=rules.genbank_to_fasta.output.fasta,
        reads=FASTQ_PATH
    output:
        cov_complete=f"{WK_DIR}/.coverage_complete"
    conda:
        MAP_ENV
    threads: 48
    run:
        bam=f"{WK_DIR}/raw_reads_aligned.bam"
        bai=f"{WK_DIR}/raw_reads_aligned.bam.bai"
        tsv=f"{WK_DIR}/raw_reads_coverage.tsv"
        coverage_calculation_cmd=f"""
            minimap2 -t {threads} -ax map-ont {input.genome} {input.reads} |
            samtools view -bS |
            samtools sort -o {bam} -
            samtools index {bam}
            samtools depth -o {tsv} {bam}
            touch {output.cov_complete}
        """
        skip_calculation_cmd=f"""
            touch {output.cov_complete}
        """
        if COMPUTE_COVERAGE:
            shell(coverage_calculation_cmd)
        else:   
            shell(skip_calculation_cmd)


rule make_plots:
    """
    Makes plots and a tsv summarizing mapping positions obtained by the 
    map_insertions rule. 

    NOTE: If mapping insertions was done in the 16S mode, the output files only
    reflect the reads that didn't map to 16S (a.k.a. off-targets). Otherwise,
    results reflect the mapping locations of ALL reads containing the insertion 
    end. 
    """
    input:
        # Make sure we've mapped either to 16S or all genomes at once, and gone through the coverage step
        rules.optional_compute_coverage.output.cov_complete,
        rules.map_insertions.output.mapping_complete,
        target_sites_file=rules.extract_insertion_end.output.target_sites_file,
        # Plotting script
        plotting_script=f"{SCRIPT_DIR}/visualize_insertions.py"
    output:
        plots_complete=f"{WK_DIR}/plots/.plots_complete"
    conda:
        MAP_ENV
    run:
        # Figure out which read file to use for plotting
        if FASTA_16S:
            mapped_reads = "mapping_16s/non_16S_mapped_to_genomes.bam"
            finish_message = (
                f"Mapping results represent mapping reads that are unmapped "
                f"to {FASTA_16S} to the provided genomes/plasmids."
            )
        else:
            mapped_reads = "aligned_contigs.bam"
            finish_message = (
                f"Mapping results represent mapping all "
                f"{INSERTION_END_TO_EXTRACT}E-containing reads "
                f"to the provided genomes/plasmids."
            )
        # Run the script with or without coverage plot
        if COMPUTE_COVERAGE:
            shell(f"""
                python {input.plotting_script} {WK_DIR} -m {mapped_reads}\
                    -t {input.target_sites_file} --end {INSERTION_END_TO_EXTRACT} \
                    --plot_coverage
            """)
        else:
            shell(f"""
                python {input.plotting_script} {WK_DIR} -m {mapped_reads}\
                    -t {input.target_sites_file} --end {INSERTION_END_TO_EXTRACT} 
            """)
        # Rename all files in the output directory for clarity
        if FASTA_16S:
            shell(r"""
                for f in {WK_DIR}/plots; do
                    for file in "$f"/*.*; do
                        base=$(basename "$file")
                        name="${{base%.*}}"
                        ext="${{base##*.}}"
                        mv "$file" "$f/${{name}}.offtarget.${{ext}}"
                    done
                done
            """)
        # Write completion file
        with open(output.plots_complete, "w") as f:
            f.write(finish_message + "\n")


rule summarize_results:
    """
    Counts reads in all fastqs/fastas in the working directory
    """    
    input:
        rules.make_plots.output.plots_complete
    output:
        read_counts=os.path.join(WK_DIR, "read_counts.txt")
    run:
        # Make a summary of fasta sizes
        def open_maybe_gzip(path, mode="rt"):
            return gzip.open(path, mode) if path.endswith(".gz") else open(path, mode)

        # Glob within any subfolder in WK_DIR
        excluded_dir = "input"

        fasta_files = [
            f for f in glob.glob(f"{WK_DIR}/**/*.fasta*", recursive=True)
            if excluded_dir not in f.split(os.sep)
        ]
        fastq_files = [
            f for f in glob.glob(f"{WK_DIR}/**/*.fastq*", recursive=True)
            if excluded_dir not in f.split(os.sep)
        ]
        fastq_files.append(FASTQ_PATH)
        # fasta_files = glob.glob(f"{WK_DIR}/**/*.fasta", recursive=True)
        with open(output.read_counts, "w") as summary_file:
            for file in fasta_files:
                with open_maybe_gzip(file, "rt") as handle:
                    # Count sequences in the file
                    count = sum([1 for _ in SeqIO.parse(handle, "fasta")])
                    # print(f"{file}: {count} sequences", file=summary_file)
                print(f"{os.path.basename(file)}: {count} sequences", file=summary_file)
            for file in fastq_files:
                with open_maybe_gzip(file, "rt") as handle:
                    # Count sequences in the file
                    count = sum([1 for _ in SeqIO.parse(handle, "fastq")])
                # print(f"{file}: {count} sequences", file=summary_file)
                print(f"{os.path.basename(file)}: {count} sequences", file=summary_file)


