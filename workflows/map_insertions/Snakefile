"""
Workflow for mapping insertions against the genome.
"""
import os

WK_DIR = config["wk_dir"]
BRNA_PLASMID_PATH = config["brna_plasmid"]
OTHER_SEQUENCE_PATHS = config["others"]#.split()
FASTQ_PATH = config["fastq_path"]
INSERTION_END_TO_EXTRACT = config.get("insertion_end_to_extract", "R") # Default to extracting RE
INSERT_END_LENGTH = config.get("insert_end_length", 200) # How much of the insertion end to extract
COMPUTE_COVERAGE = config.get('compute_coverage', False)
QUALITY_FILTER = config.get("quality_filter", 0) # Default to no quality filtering
MIN_TRIMMED_READ_LENGTH = config.get("min_trimmed_read_length", 1) # Default minimum trimmed read length
FASTA_16S = config.get("fasta_16s", False) # Whether to explicitly map reads to 16S vs genomes

SCRIPT_DIR = "../../scripts"
MAP_ENV = "../../envs/map_env.yml"


def cutadapt_end_option(end):
    if end == "R":
        return "g"
    elif end == "L":
        return "a"
    else:
        raise ValueError(f"Invalid end: {end}")


rule all:
    input:
        f"{WK_DIR}/aligned_contigs.bam.bai",
        f"{WK_DIR}/plots/.plots_complete",
        f"{WK_DIR}/mapping_16s/.16S_mapping_complete"


rule extract_insertion_end:
    input:
        brna=BRNA_PLASMID_PATH,
        others=OTHER_SEQUENCE_PATHS
    output:
        end_file=f"{WK_DIR}/input/{INSERTION_END_TO_EXTRACT}E.fasta", # NOTE: this won't work if multiple ends are extracted!!
        target_sites_file=f"{WK_DIR}/input/target_sites.tsv"
    conda:
        MAP_ENV
    shell:
        """
        mkdir -p {WK_DIR}/input
        python {SCRIPT_DIR}/extract_insertion_end.py \
            -b {input.brna} \
            -s {input.others} \
            -o {WK_DIR}/input \
            -n {INSERT_END_LENGTH} \
            -m {INSERTION_END_TO_EXTRACT} \
            --save_targets
        """


rule genbank_to_fasta:
    input:
        rules.extract_insertion_end.output.end_file,
        brna=BRNA_PLASMID_PATH,
        others=OTHER_SEQUENCE_PATHS
    output:
        fasta=f"{WK_DIR}/input/sequences.fasta"
    conda:
        MAP_ENV
    shell:
        """
        python {SCRIPT_DIR}/genbank_to_fasta.py {output.fasta} {input.brna} {input.others}
        """

rule filter_read_quality:
    input:
        fastq=FASTQ_PATH
    output:
        reads_quality_filtered=f"{WK_DIR}/reads_quality_filtered.fastq",
        # low_quality_reads=f"{WK_DIR}/reads_low_quality.fastq"
    conda:
        MAP_ENV
    shell:
        """
        cutadapt -q {QUALITY_FILTER},{QUALITY_FILTER} {input.fastq} | seqkit seq -Q {QUALITY_FILTER} -o {output.reads_quality_filtered}
        """
        # # Extract low quality reads too for record-keeping # NOTE: doesn't work currently...
        # seqkit seq -n {output.reads_quality_filtered} > high_quality_ids.tmp
        # seqkit grep -v -f high_quality_ids.tmp {input.fastq} > {output.low_quality_reads}
        # rm high_quality_ids.tmp


rule cutadapt_extract_insertions:
    input:
        rules.genbank_to_fasta.output.fasta,
        end_file = rules.extract_insertion_end.output.end_file,
        fastq = rules.filter_read_quality.output.reads_quality_filtered
    output:
        reads_with_insertion = f"{WK_DIR}/{INSERTION_END_TO_EXTRACT}E_contain_reads_any.fasta",
        reads_no_insertion = f"{WK_DIR}/reads_no_insertion.fasta",
        reads_too_short = f"{WK_DIR}/{INSERTION_END_TO_EXTRACT}E_contain_reads_below_{MIN_TRIMMED_READ_LENGTH}nt.fasta"
    conda:
        MAP_ENV
    params:
        end_option = lambda wildcards: cutadapt_end_option(INSERTION_END_TO_EXTRACT)
    shell:
        """
        cutadapt \
            -{params.end_option} "file:{input.end_file}" \
            --revcomp --fasta \
            --untrimmed-output {output.reads_no_insertion} \
            --too-short-output {output.reads_too_short} \
            -O 20 \
            -j 0 \
            -m {MIN_TRIMMED_READ_LENGTH} \
            {input.fastq} > {output.reads_with_insertion}
        """

rule cutadapt_trim_2:
    """
    Use cutadapt to remove trimmed reads that contain multiple insertion ends. 
    """
    input:
        trimmed = rules.cutadapt_extract_insertions.output.reads_with_insertion,
        end_file = rules.extract_insertion_end.output.end_file
    output:
        trimmed_1_insert=f"{WK_DIR}/{INSERTION_END_TO_EXTRACT}E_contain_reads.fasta",
        # full_reads_with_1_insertion = f"{WK_DIR}/{INSERTION_END_TO_EXTRACT}E_contain_reads.full_reads.fasta",
    conda:
        MAP_ENV
    params:
        end_option = lambda wildcards: cutadapt_end_option(INSERTION_END_TO_EXTRACT)
    shell:
        """
        cutadapt \
            --revcomp \
            --fasta \
            --discard-trimmed \
            -O 20 \
            -j 0 \
            -{params.end_option} file:{input.end_file} \
            {input.trimmed} > {output.trimmed_1_insert}
        """
        # # Get the full reads corresponding to the trimmed reads with insertions (for record-keeping)
        # seqkit seq -n {output.trimmed_1_insert} | sed 's/ rc$//' > trimmed_ids.tmp
        # seqkit grep -f trimmed_ids.tmp {FASTQ_PATH} -o {output.full_reads_with_1_insertion}
        # # rm trimmed_ids.tmp


rule map_insertions:
    input:
        rules.cutadapt_trim_2.output.trimmed_1_insert,
        sequences=rules.genbank_to_fasta.output.fasta,
        reads=rules.cutadapt_extract_insertions.output.reads_with_insertion
    output:
        bam=f"{WK_DIR}/aligned_contigs.bam",
        bai=f"{WK_DIR}/aligned_contigs.bam.bai"
    conda:
        MAP_ENV
    threads: 48
    shell:
        """
        minimap2 -t {threads} -ax map-ont {input.sequences} {input.reads} |
        samtools view -bS |
        samtools sort -o {output.bam} -
        samtools index {output.bam}
        """


rule optional_compute_coverage:
    input:
        rules.map_insertions.output.bam,
        genome=rules.genbank_to_fasta.output.fasta,
        reads=FASTQ_PATH
    output:
        cov_complete=f"{WK_DIR}/.coverage_complete"
    
    conda:
        MAP_ENV
    threads: 48
    run:
        bam=f"{WK_DIR}/raw_reads_aligned.bam"
        bai=f"{WK_DIR}/raw_reads_aligned.bam.bai"
        tsv=f"{WK_DIR}/raw_reads_coverage.tsv"
        coverage_calculation_cmd=f"""
            minimap2 -t {threads} -ax map-ont {input.genome} {input.reads} |
            samtools view -bS |
            samtools sort -o {bam} -
            samtools index {bam}
            samtools depth -o {tsv} {bam}
            touch {output.cov_complete}
        """
        skip_calculation_cmd=f"""
            touch {output.cov_complete}
        """
        if COMPUTE_COVERAGE:
            shell(coverage_calculation_cmd)
        else:   
            shell(skip_calculation_cmd)


rule make_plots:
    input:
        rules.optional_compute_coverage.output.cov_complete,
        target=rules.extract_insertion_end.output.target_sites_file,
        bam=rules.map_insertions.output.bam
    output:
        plots_complete=f"{WK_DIR}/plots/.plots_complete"
    conda:
        MAP_ENV
    run:
        if COMPUTE_COVERAGE:
            shell(f"""
                python {SCRIPT_DIR}/visualize_insertions.py {WK_DIR} \
                    -t {input.target} \
                    --plot_coverage
                touch {output.plots_complete}
            """)
        else:
            shell(f"""
                python {SCRIPT_DIR}/visualize_insertions.py {WK_DIR} \
                    -t {input.target}
                touch {output.plots_complete}
            """)


rule map_16s_vs_genomes:
    input:
        rules.optional_compute_coverage.output.cov_complete,
        reads=rules.cutadapt_trim_2.output.trimmed_1_insert,
        genomes=rules.genbank_to_fasta.output.fasta,

    output:
        mapping_complete=f"{WK_DIR}/mapping_16s/.16S_mapping_complete"
    conda:
        MAP_ENV
    threads: 48
    run:
        if FASTA_16S:
            print("Mapping to 16S sequences as well as genomes")
            shell(f"""
                {SCRIPT_DIR}/map_16S.sh {input.reads} {FASTA_16S} {input.genomes}
                python {SCRIPT_DIR}/summarize_16S_mapping.py {WK_DIR}
                touch {output.mapping_complete}
                """)
        else:
            shell(f"touch {output.mapping_complete}")
        # Make a summary of fasta sizes
        from Bio import SeqIO
        import glob
        import sys
        import gzip

        def open_maybe_gzip(path, mode="rt"):
            return gzip.open(path, mode) if path.endswith(".gz") else open(path, mode)

        # Glob within any subfolder in WK_DIR
        excluded_dir = "input"

        fasta_files = [
            f for f in glob.glob(f"{WK_DIR}/**/*.fasta*", recursive=True)
            if excluded_dir not in f.split(os.sep)
        ]
        fastq_files = [
            f for f in glob.glob(f"{WK_DIR}/**/*.fastq*", recursive=True)
            if excluded_dir not in f.split(os.sep)
        ]
        fastq_files.append(FASTQ_PATH)
        # fasta_files = glob.glob(f"{WK_DIR}/**/*.fasta", recursive=True)
        with open(os.path.join(WK_DIR, "read_counts.txt"), "w") as summary_file:
            for file in fasta_files:
                with open_maybe_gzip(file, "rt") as handle:
                    # Count sequences in the file
                    count = sum([1 for _ in SeqIO.parse(handle, "fasta")])
                    # print(f"{file}: {count} sequences", file=summary_file)
                print(f"{os.path.basename(file)}: {count} sequences", file=summary_file)
            for file in fastq_files:
                with open_maybe_gzip(file, "rt") as handle:
                    # Count sequences in the file
                    count = sum([1 for _ in SeqIO.parse(handle, "fastq")])
                # print(f"{file}: {count} sequences", file=summary_file)
                print(f"{os.path.basename(file)}: {count} sequences", file=summary_file)
    # shell:
    #     """
    #     minimap2 -t {threads} -ax map-ont {input.sequences} {input.out} |
    #     samtools view -bS |
    #     samtools sort -o {output.bam} -
    #     samtools index {output.bam}
    #     """
