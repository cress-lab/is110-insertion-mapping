"""
Workflow for finding + classifying taxonomy for 16S sequences with insertions 
from community editing experiments.
USAGE:
    snakemake --cores 80 --rerun-incomplete --use-conda \
    --config \
        wk_dir="../../data/community_editing/DKDTH4" \
        fastq_path="../../sequences/reads/DKDTH4_1_MCKanCm_gPCR.fastq" \
        brna_plasmid_file="../../sequences/plasmids/pJRP1063.gbk" 
NOTE: include --conda-frontend mamba if need to install envs
    - There are issues with installing the bridgernadesigner via pip using mamba
"""

import os
from snakemake.io import directory
import yaml

# configfile: "config.yaml"

script_dir = config["script_dir"]
map_env = "../../envs/map_env.yml"
qiime2_env = "../../envs/qiime2-amplicon-2024.10-py310-linux-conda.yml"
LE_LENGTH = 50
MIN_LEN_POST_TRIM = config["min_length"] - LE_LENGTH

# Verify that all the right config arguments have been provided
def required_config(keys):
    for key in keys:
        if key not in config:
            raise ValueError(f"Missing required config key: '{key}'")

required_config(["wk_dir", "fastq_path", "brna_plasmid_file"])

rule all:
    input:
        taxonomy = os.path.join(config["wk_dir"], "taxonomy", "taxonomy_table.tsv"),
        configfile = os.path.join(config["wk_dir"], "config.yaml")


rule save_config:
    output:
        dest = os.path.join(config["wk_dir"], "config.yaml")
    conda:
        map_env
    run:
        with open(output.dest, "w") as f:
            yaml.dump(config, f, default_flow_style=False)


rule extract_le:
    input:
        # "logs/bridgernadesigner_checked.txt",
        brna_plasmid_file = config["brna_plasmid_file"]
    output:
        le = os.path.join(config["wk_dir"], "input", "LE.fasta")
    conda:
        map_env
    shell:
        """
        mkdir -p {config[wk_dir]}/input
        python {script_dir}/extract_insertion_end.py \
            -b {input.brna_plasmid_file} \
            -o {config[wk_dir]}/input \
            -m "L" \
            -n {LE_LENGTH}
        """


rule amplicon_size_filter:
    input:
        fastq = config["fastq_path"]
    output:
        reads = os.path.join(config["wk_dir"], "reads_size_filtered.fastq")
    conda:
        qiime2_env
    shell:
        """
        python {script_dir}/amplicon_size_filter.py \
            -i {input.fastq} \
            -a {config[max_length]} \
            -b {config[min_length]} \
            -o {config[wk_dir]}
        """

rule cutadapt_trim:
    """
    Use cutadapt to find reads with the LE.
    """
    input:
        reads = rules.amplicon_size_filter.output.reads,
        le = rules.extract_le.output.le 
    output:
        trimmed = os.path.join(config["wk_dir"], "LE_containing_amplicons_any.fasta")
    conda:
        qiime2_env
    shell:
        """
        cutadapt \
            --revcomp \
            --fasta \
            --discard-untrimmed \
            -m {MIN_LEN_POST_TRIM} \
            -O 10 \
            -j 0 \
            -a file:{input.le} \
            {input.reads} > {output.trimmed}
        """

rule cutadapt_trim_2:
    """
    Use cutadapt to remove trimmed reads that contain another LE, since this 
    would indicate that the read is a chimera.
    """
    input:
        trimmed = rules.cutadapt_trim.output.trimmed,
        le = rules.extract_le.output.le
    output:
        trimmed_1_le = os.path.join(config["wk_dir"], "LE_containing_amplicons.fasta")
    conda:
        qiime2_env
    shell:
        """
        cutadapt \
            --revcomp \
            --fasta \
            --discard-trimmed \
            -O 10 \
            -j 0 \
            -a file:{input.le} \
            {input.trimmed} > {output.trimmed_1_le}
        """

rule remove_chimeras:
    input:
        trimmed = rules.cutadapt_trim_2.output.trimmed_1_le
    output:
        nonchimeras = os.path.join(config["wk_dir"], "nonchimeras.fasta"),
        chimeras = os.path.join(config["wk_dir"], "chimeras.fasta"),
        borderline = os.path.join(config["wk_dir"], "borderline.fasta"),
        # TEMPORARY: save chimera alignments
        chimera_aln = os.path.join(config["wk_dir"], "chimera_alns.txt")
    conda:
        qiime2_env
    shell:
        """
        vsearch --uchime_ref {input.trimmed} \
            --db {config[uchime_db]} \
            --threads 0 \
            --nonchimeras {output.nonchimeras} \
            --chimeras {output.chimeras} \
            --borderline {output.borderline} \
            --uchimealns {output.chimera_aln}
        """

rule qiime_import:
    input:
        fasta = rules.remove_chimeras.output.nonchimeras
    output:
        qza = os.path.join(config["wk_dir"], "nonchimeras.qza")
    conda:
        qiime2_env
    shell:
        """
        qiime tools import \
            --input-path {input.fasta} \
            --output-path {output.qza} \
            --type 'FeatureData[Sequence]' \
            --input-format DNAFASTAFormat
        """

rule qiime_classify:
    input:
        qza = rules.qiime_import.output.qza
    output:
        taxonomy = os.path.join(config["wk_dir"], "nonchimeras.taxonomy.qza")
    conda:
        qiime2_env
    shell:
        """
        qiime feature-classifier classify-sklearn \
            --i-classifier {config[qiime_classifier]} \
            --i-reads {input.qza} \
            --o-classification {output.taxonomy}
        """

rule qiime_export_taxonomy:
    input:
        taxonomy = rules.qiime_classify.output.taxonomy
    output:
        taxonomy_dir = directory(os.path.join(config["wk_dir"], "taxonomy")),
        taxonomy_table = os.path.join(config["wk_dir"], "taxonomy", "taxonomy.tsv")
    conda:
        qiime2_env
    shell:
        """
        qiime tools export \
            --input-path {input.taxonomy} \
            --output-path {output.taxonomy_dir}
        """

rule process_taxonomy:
    input:
        taxonomy_table = rules.qiime_export_taxonomy.output.taxonomy_table,
        taxonomy_dir = os.path.join(config["wk_dir"], "taxonomy")
    output:
        os.path.join(config["wk_dir"], "taxonomy", "taxonomy_table.tsv")
    conda:
        qiime2_env
    shell:
        """
        python {script_dir}/process_taxonomy.py {input.taxonomy_table} {input.taxonomy_dir}
        """
